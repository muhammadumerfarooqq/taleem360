# Placeholders only. Never put real values here and never commit a real .env file.
# Copy the VITE_* lines into app/.env and the backend lines into backend/.env.

# --- App (app/.env) ---
VITE_USE_MOCK=true
VITE_BACKEND_URL=http://localhost:8000
# Planned (Firebase web config, step 5)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# --- Backend (backend/.env, planned) ---
GEMINI_API_KEY=your-gemini-api-key
FIREBASE_PROJECT_ID=your-project-id
# Path to the service-account file on the server. The file itself is never committed.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
CHROMA_PATH=./chroma_db
ALLOWED_ORIGINS=http://localhost:5173
