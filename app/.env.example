# Placeholders only. Copy this file to .env.local (never commit .env.local) and fill in your own values.
# Anything starting with VITE_ is visible to everyone who opens the app: only PUBLIC values go here.

# Demo mode (sample data, demo login). Set to "false" to use real sign-in and the real backend.
VITE_USE_MOCK=true
VITE_BACKEND_URL=

# Real sign-in with Supabase. Used ONLY when VITE_USE_MOCK=false AND both values below are filled in.
# Use the project URL and the PUBLIC anon / publishable key (Supabase dashboard > Project Settings > API).
# NEVER put the secret (admin) key here or anywhere in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
